{
  "name": "polyvault",
  "version": "0.3.0",
  "description": "Upload once to a free R2 hub; fan out to Drive/OneDrive/Dropbox via a free-tier relay.",
  "type": "module",
  "bin": {
    "polyvault": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "relay": "tsx src/relay/main.ts",
    "relay:prod": "node dist/relay/main.js",
    "test": "tsx --test test/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "cloud",
    "upload",
    "r2",
    "s3",
    "google-drive",
    "onedrive",
    "relay"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "commander": "^13.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
